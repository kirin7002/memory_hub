DATABASE_URL=postgres://memoryhub:memoryhub_dev@127.0.0.1:55432/memoryhub?sslmode=disable
TEST_DATABASE_URL=postgres://memoryhub:memoryhub_dev@127.0.0.1:55432/memoryhub?sslmode=disable
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=local-demo-only-change-before-sharing-32bytes
LISTEN_ADDR=127.0.0.1:18080
MEMORYHUB_URL=http://127.0.0.1:18080
WEB_DEMO_ENABLED=true

# 百炼北京地域兼容 API；也可换成业务空间专属域名，见 llm-setup.md。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
# 在本地 .env 中填写；也支持 DASHSCOPE_API_KEY。不要提交真实 Key。
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false
